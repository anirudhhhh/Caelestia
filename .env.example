# ControlPlane.ai — Environment Configuration
# Copy this to .env and fill in your values

# ─── LLM Provider Keys ───────────────────────────────────────────────────────
# OpenRouter (supports 100+ models via one API key)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini (direct API access)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Model Configuration ─────────────────────────────────────────────────────
# Default model for general requests
DEFAULT_MODEL=google/gemini-2.0-flash-001

# Model used for AI-as-judge (hallucination detection, output verification)
JUDGE_MODEL=google/gemini-2.0-flash-001

# Available models for routing (comma-separated, OpenRouter model IDs)
AVAILABLE_MODELS=google/gemini-2.0-flash-001,google/gemini-2.5-flash-preview-05-20,anthropic/claude-sonnet-4

# ─── Service URLs (defaults work for local dev) ──────────────────────────────
GATEWAY_URL=http://localhost:8000
INPUT_GUARD_URL=http://localhost:8001
OUTPUT_GUARD_URL=http://localhost:8002
PII_SERVICE_URL=http://localhost:8003
POLICY_ENGINE_URL=http://localhost:8004
ROUTER_URL=http://localhost:8005
ADAPTER_URL=http://localhost:8006
AUDIT_STORE_URL=http://localhost:8007
REVIEW_CONSOLE_URL=http://localhost:8008
IMMUNE_SYSTEM_URL=http://localhost:8009
ACTION_GUARD_URL=http://localhost:8010

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///data/controlplane.db

# PostgreSQL (production path — uncomment to use)
# DATABASE_URL=postgresql://controlplane:password@localhost:5432/controlplane

# ─── Redis (optional, for escalation queue) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
