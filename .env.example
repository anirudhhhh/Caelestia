# ControlPlane.ai — Environment Configuration
# Copy this file to .env and configure your keys:
#   cp .env.example .env

# ─── LLM Provider Keys (Google Gemini Native) ────────────────────────────────
# Google Gemini API (Direct Google AI Studio access)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Model Configuration ─────────────────────────────────────────────────────
# Default model used for general completions
DEFAULT_MODEL=gemini-3.5-flash-lite

# Model used for AI-as-Judge (Hallucination detection, factual groundedness verification)
JUDGE_MODEL=gemini-3.5-flash-lite

# Available models for the Semantic Router & Load Balancer (comma-separated Gemini model IDs)
AVAILABLE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash,gemini-3.7-flash

# Default System Prompt for the perimeter gateway
CONTROLPLANE_SYSTEM_PROMPT="You are an enterprise AI assistant protected by ControlPlane.ai."

# ─── Microservice URLs (Ports 8000 - 8011) ──────────────────────────────────
GATEWAY_URL=http://localhost:8000
INPUT_GUARD_URL=http://localhost:8001
OUTPUT_GUARD_URL=http://localhost:8002
PII_SERVICE_URL=http://localhost:8003
POLICY_ENGINE_URL=http://localhost:8004
ROUTER_URL=http://localhost:8005
ADAPTER_URL=http://localhost:8006
AUDIT_STORE_URL=http://localhost:8007
REVIEW_CONSOLE_URL=http://localhost:8008
IMMUNE_SYSTEM_URL=http://localhost:8009
ACTION_GUARD_URL=http://localhost:8010
GUARDRAILS_ML_URL=http://localhost:8011

# ─── Database Configuration ──────────────────────────────────────────────────
# Default: Embedded SQLite database (zero-setup, created automatically)
DATABASE_URL=sqlite:///data/controlplane.db

# Production: PostgreSQL (uncomment to connect to external Postgres)
# DATABASE_URL=postgresql://controlplane:password@localhost:5432/controlplane

# ─── Redis (Optional: Hot Session Locks & Rate Limiting) ─────────────────────
REDIS_URL=redis://localhost:6379

# ─── Logging & Telemetry ─────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Frontend Web Application ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
